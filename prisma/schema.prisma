datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. ユーザー情報
model User {
  id                      String   @id @default(uuid())
  studentNumber           Int?     @unique // 出席番号
  name                    String
  email                   String   @unique
  password                String
  isAdmin                 Boolean  @default(false)
  emailVerified           Boolean  @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?
  resetToken              String?
  resetTokenExpiry        DateTime?
  lessons                 Lesson[]
  tasks                   Task[]
  createdAt               DateTime @default(now())
}

// 1b. 監査ログ
model AuditLog {
  id        String   @id @default(uuid())
  actorType String   // user, admin, system
  actorId   String?
  email     String?
  action    String
  resource  String?
  result    String   // success, failure
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorType])
}

// 2. 授業情報
model Lesson {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek String   // 月、火、水、木、金
  period    Int      // 1, 2, 3, 4, 5, 6 限
  subject   String   // 教科名
}

// 3. 課題情報
model Task {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminBatchId String?
  subject   String   // 教科名
  title     String   // 課題のタイトル
  dueDate   DateTime // 締切日
  note      String?  // 補足
  isCompleted Boolean @default(false) // 状態（未完了: false, 完了: true）
}

// 4. テストスケジュール（期間）
model TestSchedule {
  id        String              @id @default(uuid())
  title     String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime            @default(now())
  entries   TestScheduleEntry[]
}

// 4b. テストスケジュールの各曜日・各時限（同一セルに複数教科可）
model TestScheduleEntry {
  id         String       @id @default(uuid())
  scheduleId String
  schedule   TestSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek  String       // 月、火、水、木、金
  period     Int
  subject    String
  note       String?
}

// 5. 管理者が登録する教科
model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// 6. 管理者からの日々の連絡
model Announcement {
  id               String   @id @default(uuid())
  announcementType String   @default("announcement") // "announcement" or "test"
  title            String
  body             String
  date             DateTime @default(now())
  createdAt        DateTime @default(now())
  reads            AnnouncementRead[]
}

// 7. 連絡の既読管理
model AnnouncementRead {
  id             String       @id @default(uuid())
  userId         String
  announcementId String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  @@unique([userId, announcementId])
}

// 8. 普段使うリンク
model DailyLink {
  id          String   @id @default(uuid())
  label       String
  description String?
  href        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
