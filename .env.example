DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Optional: used by Prisma CLI migrations. For Supabase, use the Session pooler URL ending in :5432.
MIGRATE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
JWT_SECRET="your_jwt_secret_here"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Resend settings
RESEND_API_KEY=""
FROM_EMAIL="onboarding@example.com"
APP_URL="http://localhost:3000"

# Cron reminder protection
CRON_SECRET="your_shared_cron_secret"
