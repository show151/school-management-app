DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Optional: used by Prisma CLI migrations. For Supabase, use the Session pooler URL ending in :5432.
MIGRATE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
JWT_SECRET="your_jwt_secret_here"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Resend settings
RESEND_API_KEY=""
FROM_EMAIL="onboarding@example.com"
APP_URL="http://localhost:3000"

# Cron reminder protection
CRON_SECRET="your_shared_cron_secret"

# Power Automate -> Microsoft Teams selected-message assignment webhook
INTEGRATION_TEAMS_FLOW_TOKEN="generate-a-long-random-token"

# External service webhook secrets (optional; when set, HMAC-SHA256 is required)
INTEGRATION_TEAMS_SECRET=""
INTEGRATION_CLASSROOM_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/classroom/callback"
GOOGLE_REDIRECT_URI_LOCAL="http://localhost:3000/api/integrations/classroom/callback"
APP_ENCRYPTION_KEY="generate-a-32-byte-hex-key"

# Microsoft Teams / Graph API
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="organizations"
MICROSOFT_REDIRECT_URI="https://www.example.com/api/integrations/teams/callback"
MICROSOFT_REDIRECT_URI_LOCAL="http://localhost:3000/api/integrations/teams/callback"
INTEGRATION_MOODLE_SECRET=""

# Optional API credentials for participant synchronization
INTEGRATION_TEAMS_ACCESS_TOKEN=""
INTEGRATION_CLASSROOM_ACCESS_TOKEN=""
INTEGRATION_MOODLE_URL=""
INTEGRATION_MOODLE_TOKEN=""
